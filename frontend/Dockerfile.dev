# CodeTrace frontend — dev image. Full deps, live reload via the Vite
# dev server against a bind-mounted frontend/src.

FROM node:22-slim

WORKDIR /build
COPY . .
RUN npm ci

WORKDIR /build/frontend

EXPOSE 5173

# --host: without it the Vite dev server only binds inside the
# container's own loopback, unreachable from outside.
CMD ["npm", "run", "dev", "--", "--host"]
