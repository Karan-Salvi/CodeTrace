# Postgres (via infra/docker-compose.dev.yml)
DATABASE_URL=postgresql://codetrace:codetrace_dev_password@localhost:5433/codetrace

# Redis (via infra/docker-compose.dev.yml)
REDIS_URL=redis://:codetrace_dev_password@localhost:6380

# GitHub OAuth + App (create a dev GitHub App at https://github.com/settings/apps/new)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# JWT
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh

# Token encryption (dev-local stand-in for the KMS master key, security.md)
TOKEN_ENCRYPTION_KEY=

# Gemini (chat + embeddings)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_VERSION=gemini-embedding-001-1536

PORT=3000
NODE_ENV=development

# Frontend origin allowed to make credentialed (cookie) cross-origin requests
CORS_ORIGIN=http://localhost:5173

# Internal service-to-service auth (worker -> backend), never exposed to a browser
INTERNAL_API_SECRET=dev-only-internal-secret-change-me
