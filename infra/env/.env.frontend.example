# Real deployed backend origin (routed through nginx, not the raw
# backend port — deployment.md's proxy). Baked into the built JS bundle
# at Docker build time (VITE_API_URL build ARG), not read at runtime.
VITE_API_URL=https://CHANGE_ME.example.com

# Same origin, wss:// scheme — websocket.ts connects to `${VITE_WS_URL}/ws`,
# proxied by infra/nginx/nginx.prod.conf's /ws location. Also baked in at
# build time (VITE_WS_URL build ARG). Missing this falls back to
# ws://localhost:3000, which only works in local dev.
VITE_WS_URL=wss://CHANGE_ME.example.com
