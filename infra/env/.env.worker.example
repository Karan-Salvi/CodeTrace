# Postgres (Docker-internal hostname — infra/docker-compose.single-vm.yml)
DATABASE_URL=postgresql://codetrace:CHANGE_ME@postgres:5432/codetrace

# Redis (Docker-internal hostname)
REDIS_URL=redis://:CHANGE_ME@redis:6379

# Backend internal API (for installation-token fetch) — Docker-internal
# hostname on a single VM; the backend VM's private IP once split
# (docker-compose.worker.yml, deployment.md's split-VM migration path).
BACKEND_INTERNAL_URL=http://backend:3000
INTERNAL_API_SECRET=CHANGE_ME_AT_LEAST_16_CHARS

# Gemini (embeddings)
GEMINI_API_KEY=CHANGE_ME
EMBEDDING_MODEL_VERSION=gemini-embedding-001-1536

# Indexing limits
MAX_FILE_SIZE_BYTES=1048576
CLONE_TIMEOUT_SECONDS=120
