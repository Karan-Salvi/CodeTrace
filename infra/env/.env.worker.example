# Postgres (via infra/docker-compose.dev.yml)
DATABASE_URL=postgresql://codetrace:codetrace_dev_password@localhost:5433/codetrace

# Redis (via infra/docker-compose.dev.yml)
REDIS_URL=redis://:codetrace_dev_password@localhost:6380

# Backend internal API (for installation-token fetch)
BACKEND_INTERNAL_URL=http://localhost:3000
INTERNAL_API_SECRET=dev-only-internal-secret-change-me

# Gemini (embeddings)
GEMINI_API_KEY=
EMBEDDING_MODEL_VERSION=gemini-embedding-001-1536

# Indexing limits
MAX_FILE_SIZE_BYTES=1048576
CLONE_TIMEOUT_SECONDS=120
