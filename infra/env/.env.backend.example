# Postgres (Docker-internal hostname — infra/docker-compose.single-vm.yml)
DATABASE_URL=postgresql://codetrace:CHANGE_ME@postgres:5432/codetrace

# Redis (Docker-internal hostname)
REDIS_URL=redis://:CHANGE_ME@redis:6379

PORT=3000
NODE_ENV=production

# Real deployed frontend origin — never a wildcard (security.md).
CORS_ORIGIN=https://CHANGE_ME.example.com

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
TOKEN_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# GitHub OAuth + App — create a real GitHub App for this deployment
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_APP_ID=CHANGE_ME
GITHUB_APP_SLUG=CHANGE_ME
GITHUB_APP_PRIVATE_KEY=CHANGE_ME
GITHUB_WEBHOOK_SECRET=CHANGE_ME

# Gemini (chat)
GEMINI_API_KEY=CHANGE_ME
GEMINI_API_KEYS_EXTRA=
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_VERSION=gemini-embedding-001-1536

JINA_API_KEY=CHANGE_ME

# Internal service-to-service auth (worker -> backend)
INTERNAL_API_SECRET=CHANGE_ME_AT_LEAST_16_CHARS

# Operator-only usage/cost dashboard — set to a real users.id to enable
OPERATOR_USER_ID=
