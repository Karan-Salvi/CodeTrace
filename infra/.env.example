# Copy to infra/.env and fill in real values before running docker compose
# from this directory (or with -f infra/docker-compose.single-vm.yml from
# the repo root — Compose resolves ${VAR} substitutions in that file
# against infra/.env either way). These 3 vars are consumed directly by
# docker-compose.single-vm.yml's ${...} substitutions — separate from the
# per-service runtime env files in infra/env/, which are loaded into each
# container via env_file: instead.

# Same value must also appear inside infra/env/.env.backend's DATABASE_URL
# and infra/env/.env.worker's DATABASE_URL — Postgres itself only reads
# this one, but the app containers need the matching password in their
# own connection strings.
POSTGRES_PASSWORD=CHANGE_ME

# Same value must also appear inside infra/env/.env.backend's REDIS_URL
# and infra/env/.env.worker's REDIS_URL, same reasoning as above.
REDIS_PASSWORD=CHANGE_ME

# Baked into the frontend's JS bundle at build time (Vite) — must be the
# real public HTTPS domain, not a Docker-internal hostname or localhost.
# Same value belongs in infra/env/.env.frontend and infra/env/.env.backend's
# CORS_ORIGIN.
VITE_API_URL=https://CHANGE_ME.example.com
