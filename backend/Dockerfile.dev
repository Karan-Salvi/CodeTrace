# CodeTrace backend — dev image. Full deps (incl. dev tooling), expects
# infra/docker-compose.single-vm.yml's dev-override or a direct bind
# mount of backend/src for live reload — mirrors worker/Dockerfile.dev's
# shape (dev iteration speed over image size).

FROM node:22-slim

WORKDIR /build
COPY . .
RUN npm ci

WORKDIR /build/backend

ENV NODE_ENV=development
EXPOSE 3000

CMD ["npm", "run", "dev"]
