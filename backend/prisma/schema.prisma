// CodeTrace database schema.
// Design source: docs/superpowers/specs/2026-08-13-database-schema-design.md
// Narrative: docs/database.md
//
// Raw-SQL supplements live in a hand-edited migration
// (backend/prisma/sql/indexes.sql): the HNSW vector index (pgvector's
// `vector` type is Unsupported() in Prisma, no index DSL for it), and the
// FTS GIN index (a computed to_tsvector() expression over concatenated
// columns — Prisma's @@index(type: Gin) only covers a real column, not an
// expression). See "Raw-SQL migration supplements" in the spec.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // url lives in backend/prisma.config.ts (Prisma 7) — reads env("DATABASE_URL")
  extensions = [vector]
}

// ---------- Identity & access ----------

model User {
  id                String   @id @default(uuid())
  githubId          BigInt   @unique @map("github_id")
  username          String
  email             String?
  avatarUrl         String?  @map("avatar_url")
  githubAccessToken String   @map("github_access_token") // encrypted at rest (docs/security.md)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sessions      Session[]
  installations RepositoryInstallation[]
  repositories  Repository[]
  conversations Conversation[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RepositoryInstallation {
  id                   String    @id @default(uuid())
  githubInstallationId BigInt    @unique @map("github_installation_id")
  userId               String    @map("user_id")
  permissions          Json
  revokedAt            DateTime? @map("revoked_at") // uninstall sets this; rows are never deleted in normal operation
  createdAt            DateTime  @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories Repository[]

  @@index([userId])
  @@map("repository_installations")
}

enum RepositoryStatus {
  PENDING
  CLONING
  PARSING
  CHUNKING
  EMBEDDING
  STORING
  INDEXED
  FAILED
}

model Repository {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  installationId   String           @map("installation_id")
  owner            String
  name             String
  githubUrl        String           @map("github_url")
  defaultBranch    String           @map("default_branch")
  currentCommitSha String?          @map("current_commit_sha")
  status           RepositoryStatus @default(PENDING)
  filesIndexed     Int              @default(0) @map("files_indexed")
  chunksIndexed    Int              @default(0) @map("chunks_indexed")
  embeddingCostUsd Decimal          @default(0) @map("embedding_cost_usd") @db.Decimal(10, 4)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation        RepositoryInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  files               File[]
  chunks              Chunk[]
  commits             Commit[]
  indexJobs           IndexJob[]
  webhookEvents       WebhookEvent[]
  conversations       Conversation[]
  pullRequests        PullRequest[]
  symbolRelationships SymbolRelationship[]
  usageLogs           UsageLog[]
  evalQuestions       EvalQuestion[]
  evalRuns            EvalRun[]

  @@unique([userId, githubUrl])
  @@index([userId])
  @@map("repositories")
}

// ---------- Indexing core ----------

model File {
  id             String   @id @default(uuid())
  repositoryId   String   @map("repository_id")
  path           String
  language       String?
  contentHash    String   @map("content_hash")
  sizeBytes      Int      @map("size_bytes")
  lastIndexedSha String   @map("last_indexed_sha")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  chunks     Chunk[]

  @@unique([repositoryId, path])
  @@index([repositoryId])
  @@map("files")
}

enum SymbolType {
  FUNCTION
  METHOD
  CLASS
  INTERFACE
}

model Chunk {
  id                    String     @id @default(uuid())
  repositoryId          String     @map("repository_id")
  fileId                String     @map("file_id")
  symbol                String
  symbolType            SymbolType @map("symbol_type")
  parentSymbol          String?    @map("parent_symbol")
  language              String
  startLine             Int        @map("start_line")
  endLine               Int        @map("end_line")
  content               String // chunk source text — backend has no clone; context assembly reads this
  contentHash           String     @map("content_hash")
  embeddingModelVersion String     @map("embedding_model_version") // worker writes from EMBEDDING_MODEL_VERSION env
  createdAt             DateTime   @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file       File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  // Worker invariant: embedding rows are upserted BEFORE chunks in the
  // STORING step — this FK enforces that ordering was respected.
  embedding  Embedding  @relation(fields: [contentHash, embeddingModelVersion], references: [contentHash, modelVersion])

  relationshipsFrom SymbolRelationship[] @relation("FromChunk")
  relationshipsTo   SymbolRelationship[] @relation("ToChunk")

  @@index([fileId])
  @@index([repositoryId, symbol])
  @@index([contentHash])
  @@map("chunks")
  // FTS GIN index (keyword path of hybrid retrieval, docs/retrieval.md)
  // on to_tsvector('simple', symbol || parent_symbol || content) can't be
  // expressed here — Prisma's Gin index type covers a single jsonb/array
  // column, not a computed to_tsvector() expression over concatenated
  // columns. Stays in backend/prisma/sql/indexes.sql.
}

model Embedding {
  contentHash  String                      @map("content_hash")
  modelVersion String                      @map("model_version")
  vector       Unsupported("vector(1536)") // gemini-embedding-001, MRL-truncated to 1536
  createdAt    DateTime                    @default(now()) @map("created_at")

  chunks Chunk[]

  @@id([contentHash, modelVersion])
  @@map("embeddings")
}

model Commit {
  id           String    @id @default(uuid())
  repositoryId String    @map("repository_id")
  sha          String
  message      String?
  authoredAt   DateTime? @map("authored_at")
  indexedAt    DateTime  @default(now()) @map("indexed_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, sha])
  @@index([repositoryId])
  @@map("commits")
}

enum IndexJobStatus {
  PENDING
  CLONING
  PARSING
  CHUNKING
  EMBEDDING
  STORING
  INDEXED
  FAILED
  RETRY
}

enum IndexJobType {
  FULL
  INCREMENTAL
}

model IndexJob {
  id           String         @id @default(uuid())
  repositoryId String         @map("repository_id")
  type         IndexJobType
  status       IndexJobStatus @default(PENDING)
  attemptCount Int            @default(0) @map("attempt_count")
  errorMessage String?        @map("error_message")
  startedAt    DateTime?      @map("started_at")
  completedAt  DateTime?      @map("completed_at")
  durationMs   Int?           @map("duration_ms")
  createdAt    DateTime       @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@map("index_jobs")
}

// ---------- Symbol graph ----------

enum RelationshipType {
  CALLS
  IMPORTS
  EXTENDS
  IMPLEMENTS
}

model SymbolRelationship {
  id               String           @id @default(uuid())
  repositoryId     String           @map("repository_id")
  fromChunkId      String           @map("from_chunk_id")
  toChunkId        String?          @map("to_chunk_id")
  relationshipType RelationshipType @map("relationship_type")
  externalTarget   String?          @map("external_target") // set only when to_chunk_id is null
  createdAt        DateTime         @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  fromChunk  Chunk      @relation("FromChunk", fields: [fromChunkId], references: [id], onDelete: Cascade)
  toChunk    Chunk?     @relation("ToChunk", fields: [toChunkId], references: [id], onDelete: Cascade)

  @@index([repositoryId, fromChunkId])
  @@index([repositoryId, toChunkId])
  @@map("symbol_relationships")
}

// ---------- Chat ----------

model Conversation {
  id           String   @id @default(uuid())
  repositoryId String   @map("repository_id")
  userId       String   @map("user_id")
  title        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([repositoryId])
  @@index([userId])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  citations      Json? // validated file/line refs (frontend citation-jump)
  retrievalMeta  Json?       @map("retrieval_meta") // chunks retrieved vs cited (docs/observability.md)
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ---------- PR review ----------

enum PullRequestStatus {
  OPEN
  MERGED
  CLOSED
}

model PullRequest {
  id              String            @id @default(uuid())
  repositoryId    String            @map("repository_id")
  githubPrNumber  Int               @map("github_pr_number")
  title           String
  author          String
  baseSha         String            @map("base_sha")
  headSha         String            @map("head_sha")
  status          PullRequestStatus @default(OPEN)
  lastReviewedSha String?           @map("last_reviewed_sha")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  reviews    PrReview[]

  @@unique([repositoryId, githubPrNumber])
  @@index([repositoryId])
  @@map("pull_requests")
}

enum PrReviewStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model PrReview {
  id              String         @id @default(uuid())
  pullRequestId   String         @map("pull_request_id")
  commitSha       String         @map("commit_sha")
  status          PrReviewStatus @default(PENDING)
  riskScore       Int?           @map("risk_score")
  riskLevel       RiskLevel?     @map("risk_level")
  riskFactors     Json?          @map("risk_factors") // which factors triggered + points — never a bare score
  findings        Json? // [{category, file, line, explanation, related_symbol, citation}]
  durationMs      Int?           @map("duration_ms")
  llmCostUsd      Decimal?       @map("llm_cost_usd") @db.Decimal(10, 4)
  writebackFailedAt DateTime?    @map("writeback_failed_at")
  // Set when the review pipeline itself throws (diff fetch, retrieval, the
  // LLM call) — status flips to FAILED with the real reason stored here,
  // instead of the row being silently abandoned at RUNNING forever with
  // no visibility into what actually happened.
  failureReason   String?        @map("failure_reason")
  createdAt       DateTime       @default(now()) @map("created_at")

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  // The actual idempotency mechanism for processPrReviewJob (pr-review.service.ts),
  // same pattern as webhook_events(event_id) — a DB-level unique constraint,
  // not an application-level find-then-act check, is what makes two
  // concurrent attempts at the same commit resolve to one row instead of
  // racing (BullMQ worker concurrency > 1, or a duplicate webhook delivery
  // enqueuing a second job with a fresh jobId for the same commit).
  @@unique([pullRequestId, commitSha])
  @@index([pullRequestId])
  @@map("pr_reviews")
}

// ---------- Ops & evaluation ----------

model WebhookEvent {
  id           String   @id @default(uuid())
  repositoryId String?  @map("repository_id") // nullable: installation-level events aren't tied to one repo
  eventId      String   @unique @map("event_id") // DB-level idempotency (docs/database.md)
  eventType    String   @map("event_type")
  processedAt  DateTime @default(now()) @map("processed_at")

  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@map("webhook_events")
}

enum UsageKind {
  INDEXING
  QA
  PR_REVIEW
}

model UsageLog {
  id                 String    @id @default(uuid())
  repositoryId       String    @map("repository_id")
  requestId          String    @map("request_id")
  queryId            String?   @map("query_id")
  jobId              String?   @map("job_id")
  kind               UsageKind
  retrievalLatencyMs Int?      @map("retrieval_latency_ms")
  llmLatencyMs       Int?      @map("llm_latency_ms")
  totalLatencyMs     Int?      @map("total_latency_ms")
  tokensUsed         Int?      @map("tokens_used")
  costUsd            Decimal?  @map("cost_usd") @db.Decimal(10, 6)
  chunksRetrieved    Int?      @map("chunks_retrieved")
  chunksCited        Int?      @map("chunks_cited")
  cacheHit           Boolean?  @map("cache_hit")
  createdAt          DateTime  @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, createdAt])
  @@map("usage_logs")
}

model EvalQuestion {
  id             String   @id @default(uuid())
  repositoryId   String   @map("repository_id") // {path, symbol} only resolves within this repo
  question       String
  expectedChunks Json     @map("expected_chunks") // [{path, symbol}] — stable across re-index, resolved at runtime
  createdAt      DateTime @default(now()) @map("created_at")

  repository Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  results    EvalResult[]

  @@index([repositoryId])
  @@map("eval_questions")
}

enum EvalConfig {
  VECTOR_ONLY
  KEYWORD_ONLY
  HYBRID
  HYBRID_RERANKED
}

model EvalRun {
  id           String     @id @default(uuid())
  repositoryId String     @map("repository_id")
  config       EvalConfig
  recallAt5    Float      @map("recall_at_5")
  precisionAt5 Float      @map("precision_at_5")
  mrr          Float
  runAt        DateTime   @default(now()) @map("run_at")

  repository Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  results    EvalResult[]

  @@map("eval_runs")
}

model EvalResult {
  id              String  @id @default(uuid())
  evalRunId       String  @map("eval_run_id")
  evalQuestionId  String  @map("eval_question_id")
  retrievedChunks Json    @map("retrieved_chunks") // ["path#symbol", ...] — survives re-index
  correct         Boolean

  evalRun      EvalRun      @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  evalQuestion EvalQuestion @relation(fields: [evalQuestionId], references: [id], onDelete: Cascade)

  @@index([evalRunId])
  @@map("eval_results")
}
